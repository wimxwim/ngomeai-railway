# ════════════════════════════════════════════════════════════════════════════
# NgomeAI Environment Variables - TEMPLATE
# ════════════════════════════════════════════════════════════════════════════
#
# UNTUK LOCAL: Copy ke .env dan isi value-nya
# UNTUK RAILWAY: Set di Railway Dashboard → Variables tab
#
# DATABASE_URL WAJIB ADA untuk app berjalan!
# ════════════════════════════════════════════════════════════════════════════

# ─── Server ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
LOG_LEVEL=info                        # debug | info | warn | error

# ─── Meta Cloud API ─────────────────────────────────────────────────────────
# Provider resmi — butuh akun WhatsApp Business API terverifikasi
META_VERIFY_TOKEN=change_me_verify_token
META_APP_SECRET=change_me_meta_app_secret
META_API_VERSION=v19.0

# ─── AI (OpenRouter) ────────────────────────────────────────────────────────
OPENROUTER_KEY=sk-or-v1-change_me
OPENROUTER_MODEL=poolside/laguna-xs.2:free
# Model fallback chain (comma-separated), dicoba berurutan jika model utama gagal
OPENROUTER_FALLBACK_MODELS=nousresearch/hermes-3-llama-3.1-405b:free,openai/gpt-oss-20b:free,poolside/laguna-m.1:free,google/gemma-4-31b-it:free,nvidia/nemotron-3-nano-30b-a3b:free,openrouter/free

# ─── Database PostgreSQL ────────────────────────────────────────────────────
# LOCAL: postgresql://postgres:password@localhost:5433/ngomeai
# RAILWAY: ${{Postgres.DATABASE_URL}} (auto-inject dari PostgreSQL service)
DATABASE_URL=postgresql://postgres:GANTI_PASSWORD_KUAT@localhost:5433/ngomeai
DB_SSL=false                          # set true jika pakai cloud DB

# ─── Redis Cache ─────────────────────────────────────────────────────────────
# LOCAL: redis://localhost:6379
# RAILWAY: ${{Redis.REDIS_URL}} (auto-inject dari Redis service)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PREFIX=ngomeai:

# ─── Admin ──────────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti_password_kuat_min8
ADMIN_JWT_SECRET=ganti_jwt_secret_minimal_32_karakter_acak

# ─── GoWA (go-whatsapp-web-multidevice) ─────────────────────────────────────
# Provider unofficial berbasis Go. Jalankan binary GoWA terpisah.
# Docs: chatbot/gowa/readme.md
# Port GoWA HARUS berbeda dari port Node.js ini (default 3001)
GOWA_URL=http://localhost:3001
# HMAC secret — harus sama dengan --webhook-secret di GoWA
# Kosongkan untuk skip verifikasi (dev only)
GOWA_WEBHOOK_SECRET=ganti_gowa_secret_kuat
# Basic auth untuk akses GoWA REST API (format: "user:password"), kosongkan jika tidak dipakai
GOWA_BASIC_AUTH=

# ─── WaHA (WhatsApp HTTP API) ────────────────────────────────────────────────
# Provider unofficial berbasis Node.js + NestJS. Jalankan via Docker.
# Docs: https://waha.devlike.pro
# Port WaHA HARUS berbeda dari port Node.js ini (default 3002)
WAHA_URL=http://localhost:3002
# API key dari WAHA_API_KEY env di WaHA container
WAHA_API_KEY=ganti_waha_api_key
# HMAC secret untuk verifikasi webhook dari WaHA (opsional)
# Kosongkan untuk skip verifikasi (dev only)
WAHA_WEBHOOK_SECRET=

# ─── Demo seed (opsional) ───────────────────────────────────────────────────
DEMO_CLIENT_ID=klien_demo_01
DEMO_CLIENT_NAME=Demo Bisnis
DEMO_PHONE_NUMBER_ID=123456789012345
DEMO_META_TOKEN=CHANGE_ME_META_TOKEN

# ─── Evolution API ─────────────────────────────────────────────
# Provider unofficial berbasis Node.js. Support multi-instance.
# Docs: https://github.com/EvolutionAPI/Evolution-API
EVOLUTION_URL=http://localhost:8080
EVOLUTION_API_KEY=ganti_evolution_api_key
