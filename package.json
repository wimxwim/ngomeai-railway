{
  "name": "codeengine-node-postgres",
  "version": "2.6.1",
  "description": "NgomeAI WhatsApp chatbot — GoWA + WaHA + Meta providers",
  "main": "src/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:init": "node src/scripts/init-db.js",
    "db:migrate": "node src/scripts/run-migrations.js",
    "db:seed": "node src/scripts/seed-demo.js",
    "test": "node --test tests/dedup.test.js tests/quota.test.js tests/webhook.test.js",
    "logs": "pm2 logs chatbot",
    "monitor": "pm2 monit",
    "deploy": "pm2 restart chatbot"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^7.0.0-rc10",
    "axios": "^1.8.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "form-data": "^4.0.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.3",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "redis": "^5.12.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  },
  "overrides": {
    "protobufjs": ">=7.5.5"
  }
}
